# The build context is what the Dockerfile may COPY. Secrets first: nothing here may
# ever reach an image layer.
.env
.env.*
*.pem
*.key
secrets/

# Not part of the service.
.git/
.github/
.claude/
.venv/
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
test-results/
tests/
scripts/
docs/
evaluations/
examples/
demo-app/
infrastructure/
*.gif
*.log
*.err
