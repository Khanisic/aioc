# AIOC environment template.
#
# Committed with NO VALUES. Copy to `.env` and fill in:
#     cp .env.example .env
# `.env` is gitignored and must stay that way - the Day 27 secrets audit scans
# git history, and a key committed today is a history rewrite then.
#
# Grouped by the day each variable is first needed, so nothing here blocks you
# before it has to. Nothing below is required for `docker compose up` to pass
# the Day 1 checkpoint - the local defaults in docker-compose.yml cover that.


# =============================================================================
# DAY 1 - local stack
# =============================================================================
# These override the defaults baked into docker-compose.yml. Leave them unset
# and the defaults apply. Set them if 5432 or 6379 are already taken on your
# machine - a port collision is the most common Day 1 failure.

POSTGRES_USER=aioc
POSTGRES_PASSWORD=aioc_dev_only
POSTGRES_DB=aioc
POSTGRES_PORT=5432
REDIS_PORT=6379



# What the application connects with. Points at the local compose stack.
# Swap to the hosted URLs below when Day 0 accounts exist - the application
# reads only these two, so nothing else has to change.
DATABASE_URL=postgresql://aioc:aioc_dev_only@localhost:5432/aioc
REDIS_URL=redis://localhost:6379/0


# =============================================================================
# DAY 2 - Claude API
# =============================================================================
# From console.anthropic.com. NOT covered by a Claude Max subscription -
# programmatic and CI usage bills separately. Set a $100 spend alert.
ANTHROPIC_API_KEY=

# Harness default model (read by aioc.llm.LLMClient). Leave unset for the code
# default. AIOC_LLM_EFFORT (low|medium|high|xhigh|max) is opt-in and Opus/Sonnet
# only - Haiku 4.5 rejects it.
# AIOC_MODEL=claude-opus-5
# AIOC_LLM_EFFORT=

# Optional overrides consumed later by the coordinator/agents; the Day 23 model
# routing experiment (Haiku/Sonnet for subagents, Opus for the coordinator)
# is driven from here.
# AIOC_COORDINATOR_MODEL=
# AIOC_SUBAGENT_MODEL=


# =============================================================================
# DAY 3 - demo app + Prometheus (self-hosted, no signup)
# =============================================================================
# All defaulted in docker-compose.yml; set only on a port collision.
# CHECKOUT_PORT=8001
# PAYMENTS_PORT=8002
# INVENTORY_PORT=8003
# PROMETHEUS_PORT=9090
#
# What the Reasoning Layer queries (Day 5 wires the Incident agent to this).
# PROMETHEUS_URL=http://localhost:9090
#
# The fake "deployed commit" the demo services report at /version. Day 4's
# code_regression failure mode changes it so a 500-spike is tied to a commit.
# DEMO_GIT_SHA=baseline


# =============================================================================
# DAY 9 - Langfuse tracing
# =============================================================================
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com


# =============================================================================
# DAY 11 - GitHub agent
# =============================================================================
# Fine-grained personal access token. Grant read-only scopes ONLY:
#   Contents: Read      Pull requests: Read      Metadata: Read
# The contract defines a `permission` error class with GITHUB_SCOPE_MISSING -
# an over-scoped token means that path never gets exercised, and a Day 16 HITL
# gate on a token that can already merge is theatre rather than a control.
# GITHUB_TOKEN=
# GITHUB_REPO=owner/name


# =============================================================================
# DAY 24 - hosted services (replaces the DAY 1 local URLs at deploy time)
# =============================================================================
# Neon or Supabase. Must have pgvector enabled - same requirement as the local
# pgvector/pgvector image.
# DATABASE_URL=postgresql://...@...neon.tech/aioc?sslmode=require
#
# Upstash. Note rediss:// (TLS), not redis://.
# REDIS_URL=rediss://...@...upstash.io:6379


# =============================================================================
# Application
# =============================================================================
AIOC_ENV=development
LOG_LEVEL=INFO
